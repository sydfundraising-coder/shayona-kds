{
  "rewrites": [
    {
      "source": "/track",
      "destination": "/track.html"
    },
    {
      "source": "/order",
      "destination": "/track.html"
    },
    {
      "source": "/menu-board",
      "destination": "/menu-board.html"
    },
    {
      "source": "/menuboard",
      "destination": "/menu-board.html"
    },
    {
      "source": "/tv",
      "destination": "/menu-board.html"
    },
    {
      "source": "/tvmenu",
      "destination": "/menu-board.html"
    },
    {
      "source": "/tv-menu",
      "destination": "/menu-board.html"
    },
    {
      "source": "/menu-slideshow",
      "destination": "/menu-slideshow.html"
    },
    {
      "source": "/slideshow",
      "destination": "/menu-slideshow.html"
    },
    {
      "source": "/photos",
      "destination": "/menu-slideshow.html"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}