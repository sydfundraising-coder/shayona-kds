{
  "id": "/kds",
  "name": "Shayona Cafe KDS",
  "short_name": "Shayona KDS",
  "description": "Kitchen display, order window, front counter and pickup board for Shayona Cafe",
  "start_url": "/?app=1",
  "scope": "/",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
  "background_color": "#0f1720",
  "theme_color": "#0f1720",
  "icons": [
    { "src": "/icons/kds-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/kds-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/kds-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
